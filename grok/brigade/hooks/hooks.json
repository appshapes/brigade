{
  "description": "Register direct Grok TUI sessions, maintain the local inbox watcher, offer one monitor setup attempt after a completed turn, and retire the receiver on exit.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GROK_PLUGIN_ROOT}/bin/brigade\" hook session-start --host grok --plugin-root \"${GROK_PLUGIN_ROOT}\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GROK_PLUGIN_ROOT}/bin/brigade\" hook prompt --host grok --plugin-root \"${GROK_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GROK_PLUGIN_ROOT}/bin/brigade\" hook session-end --host grok --plugin-root \"${GROK_PLUGIN_ROOT}\"",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${GROK_PLUGIN_ROOT}/bin/brigade\" hook stop --host grok --plugin-root \"${GROK_PLUGIN_ROOT}\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
