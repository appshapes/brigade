# `brigade doing` through the real binary (card 25, plan 5.1, 5.2).
#
# U-05 first: every input refusal — empty, over-long, not UTF-8, a
# credential shape, a home path, positional arguments — is exit 3 (or 2)
# BEFORE any spawn: the fake adapter's dump file, which every child
# appends to, does not exist afterwards. Then the sentence on stdin, the
# confirmation line, the heartbeat document the adapter received (one
# member, under `--session <self>`), `--clear`, the mode gate the hook
# froze into the map (off and unsupported publish nothing at exit 0, and
# name no option), and `--json`. (A terminal on stdin is the unit test's:
# testscript cannot supply one.)

# --- fixture: the by-pid map the SessionStart hook would have written ----
# CLAUDE_PID is set, so every command resolves everything from the map
# under $XDG_STATE_HOME/brigade (never from the shell's BRIGADE_*), which
# names the scripted fake adapter behind an absolute path. The map is
# written 0600 by `expand`; the reader refuses anything else. This first
# map carries no doing_mode at all — a map written before the member
# existed — which publishes.
# The `brigade` under test is the race-instrumented test binary too; without
# this every exec spends TSan's 1 s atexit sleep (see fake.sh).
env GORACE=atexit_sleep_ms=0
env CLAUDE_PID=4242
env HOME=$WORK/home
mkdir $WORK/home
mkdir $WORK/.brigade/xdg/state/brigade/sessions/by-pid
expand map.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
expand script.json.in script.json
chmod 755 fake.sh
# On macOS the FIRST exec of a freshly created executable is suspended
# while the system assesses it — measured 2026-09-03: 0.2–0.5 s idle and
# 3–6 s while a whole-tree `go test` creates every package's binaries at
# once; the second exec costs ~10 ms. Both fake.sh (the file the harness
# execs) and the `fake-adapter` copy testscript installed are fresh, so
# the wrapper is run once here with no deadline, and the harness's 3 s
# describe budget (4.1) below meets warm files. (The `brigade` copy is
# warmed by its own first exec, which has no deadline.)
exec $WORK/fake.sh --script warm.json describe

# --- an empty sentence spawns nothing ----------------------------------------
stdin empty.txt
status 3 brigade doing
! stdout .
stderr 'brigade doing failed \(invalid_input\): the sentence is empty'
! exists $WORK/dump.ndjson

# The same refusal as an envelope carries the 4.3.1 details.
stdin empty.txt
status 3 brigade doing --json
! stderr .
json stdout .ok false
json stdout .error.code invalid_input
json stdout .error.details.field session_description
json stdout .error.details.reason empty
! exists $WORK/dump.ndjson

# --- an over-long sentence (a 300-character indented paragraph) is refused, never cut
stdin long.txt
status 3 brigade doing --json
json stdout .error.code invalid_input
json stdout .error.details.reason too_long
json stdout .error.details.limit 160
json stdout .error.details.unit codepoints
! stdout truncated
! exists $WORK/dump.ndjson

# --- not UTF-8: two bytes no UTF-8 sequence contains, written by printf ---------
exec printf '\377\376'
stdin stdout
status 3 brigade doing --json
json stdout .error.details.reason not_utf8
! exists $WORK/dump.ndjson

# --- a join-secret shape is refused, and the refusal never echoes it ------------
stdin secret.txt
status 3 brigade doing
stderr 'brigade doing failed \(invalid_input\): the sentence looks like it carries a credential'
! stderr brg1
! exists $WORK/dump.ndjson

# --- the home directory, and any two-segment absolute path, is refused ---------
expand homepath.in homepath.txt
stdin homepath.txt
status 3 brigade doing --json
json stdout .error.details.reason local_path
! stdout home
! exists $WORK/dump.ndjson

# --- positional arguments are usage: the sentence travels on stdin only ---------
stdin body.txt
status 2 brigade doing 'fixing the roster'
stderr 'brigade doing failed \(usage\): doing takes no arguments: the sentence travels on stdin in a quoted heredoc \(<<''EOF''\), and --clear removes it'
! exists $WORK/dump.ndjson

# --- the sentence on stdin (a quoted heredoc in the Bash tool) ------------------
stdin body.txt
exec brigade doing
cmp stdout want-published.txt
! stderr .
exists $WORK/dump.ndjson

# The adapter received `session heartbeat --session <self>` under the map's
# profile with the request document on its stdin: 73 bytes, which is
# exactly {"session_description":"<the sentence>"} — one member (a second
# member would change the count; the unit test decodes the document).
grep '"verb":"heartbeat","args":\["--session","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"\],"stdin_bytes":73' dump.ndjson
grep '"group":"describe","verb":"","args":\[\],"stdin_bytes":0' dump.ndjson
grep '"--profile","alpha"' dump.ndjson
# Ruling 12: the verb keeps no local copy, no stamp, no state of any kind
# — with a WRITABLE state directory, where a best-effort write would land.
! exists $WORK/.brigade/xdg/state/brigade/state

# --- --clear sends "" as the one member and reads nothing from stdin ------------
rm $WORK/dump.ndjson
stdin secret.txt
exec brigade doing --clear
stdout '^cleared: teammates no longer see what this session is doing$'
! stderr .
grep '"verb":"heartbeat","args":\["--session","aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"\],"stdin_bytes":26' dump.ndjson

# --- the --json result ------------------------------------------------------------
rm $WORK/dump.ndjson
stdin body.txt
exec brigade doing --json
! stderr .
json stdout .ok true
json stdout .result.self_session_id aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
json stdout .result.session_description 'card 25 part A - the verb, the option, the mode'
json stdout .result.published true
json stdout .result.cleared false
json stdout .result.note 'published to the team roster as unverified text; replace it with brigade doing when the work changes, remove it with brigade doing --clear'

# --- a map whose mode is off: exit 0, nothing published, no heartbeat, no option named
rm $WORK/dump.ndjson
expand map-off.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
stdin body.txt
exec brigade doing
stdout '^not published: this session does not publish a doing line\. Carry on with the work\.$'
! stdout share_doing
! stdout option
! stderr .
! grep heartbeat dump.ndjson
stdin body.txt
exec brigade doing --json
json stdout .result.published false
json stdout .result.reason not_shared

# --clear still works under off: opting out can retract at once.
rm $WORK/dump.ndjson
exec brigade doing --clear
stdout '^cleared: '
grep '"verb":"heartbeat"' dump.ndjson

# --- a map whose mode is unsupported: the same line, and --clear is refused too
rm $WORK/dump.ndjson
expand map-unsupported.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
stdin body.txt
exec brigade doing
stdout '^not published: '
! grep heartbeat dump.ndjson
exec brigade doing --clear --json
json stdout .result.published false
json stdout .result.cleared false
json stdout .result.reason unsupported
! grep heartbeat dump.ndjson

# --- outside a session there is no self: config, nothing spawned ----------------
env CLAUDE_PID=
rm $WORK/dump.ndjson
stdin body.txt
status 11 brigade doing
stderr 'brigade doing failed \(config\)'
! exists $WORK/dump.ndjson

-- map.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- map-off.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "doing_mode": "off", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- map-unsupported.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "doing_mode": "unsupported", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- fake.sh --
#!/bin/sh
# The scripted fake adapter behind an absolute path: the by-pid map needs
# one, and the testscript PATH entry that holds `fake-adapter` has no
# script variable. The harness execs this file; it is an adapter with a
# shebang line, not a shell the harness spawned.
# GORACE: under `go test -race` this fake is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit — not Brigade behaviour, but a third of the 3 s describe budget of
# 4.1 on a loaded machine (measured: every fake-adapter script timed out
# on describe under a whole-tree `make test`). The harness builds the
# child's environment from scratch, so the variable is set here, not in
# the script's environment.
GORACE=atexit_sleep_ms=0 exec fake-adapter "$@"
-- script.json.in --
{"dump_file": "$WORK/dump.ndjson", "responses": {"session heartbeat": [{"result": {"session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "state": "active", "lease_until": "2026-09-02T12:02:00Z", "server_time": "2026-09-02T12:00:31Z"}}]}}
-- body.txt --
card 25 part A - the verb, the option, the mode
-- empty.txt --
-- secret.txt --
rotating brg1.team-7.deadbeefdeadbeefdeadbeefdeadbeef now
-- homepath.in --
editing $HOME/work/main.go now
-- long.txt --
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
-- want-published.txt --
published: card 25 part A - the verb, the option, the mode
-- warm.json --
{}
