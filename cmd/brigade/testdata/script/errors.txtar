# --- rate_limited (8): never retried, and the human line names the wait ------
expand script-rate_limited.in script.json
rm $WORK/dump.ndjson
stdin body.txt
status 8 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stderr '^brigade send failed \(rate_limited\): the adapter said rate_limited; retry after 3 s$'
grep -count=1 '"verb":"send"' dump.ndjson
stdin body.txt
status 8 brigade --json send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
json stdout .error.code rate_limited
json stdout .error.retryable true
json stdout .error.retry_after_ms 2500

# --- unavailable (9): retried exactly once with the same key, then reported ---
expand script-unavailable.in script.json
rm $WORK/dump.ndjson
stdin body.txt
status 9 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stderr '^brigade send failed \(unavailable\): the adapter said unavailable$'
grep -count=2 '"verb":"send"' dump.ndjson

# --- protocol_mismatch (10): a protocol_version "2" describe -------------------
expand script-mismatch.in script.json
rm $WORK/dump.ndjson
stdin body.txt
status 10 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stderr '^brigade send failed \(protocol_mismatch\): '
! grep '"verb":"send"' dump.ndjson
status 10 brigade sessions --json
json stdout .error.code protocol_mismatch
json stdout .error.details.adapter_name fake-adapter
json stdout .error.details.adapter_protocol_version 2
json stdout .error.details.harness_protocol_version 1

# --- usage (2) is the harness's own ------------------------------------------
status 2 brigade send --nope
! stdout .
stderr '^brigade send failed \(usage\): '
status 2 brigade --json team
json stdout .error.code usage

# --- config (11): not registered — the message the skill documents ------------
env CLAUDE_PID=7777
status 11 brigade sessions
stderr '^brigade sessions failed \(config\): this session is not registered with Brigade'
stderr 'run /reload-plugins or restart the session'
status 11 brigade sessions --json
json stdout .error.code config
json stdout .error.details.reason not_registered

