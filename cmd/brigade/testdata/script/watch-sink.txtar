# `brigade watch --sink <file>` through the real binary (P3-5; plan 6.6,
# 6.8): the detached watcher run directly with the environment the hook
# builds, in sink mode (no inbox socket variable), against the scripted
# fake adapter whose `message watch` replays one message. The frame lands
# in the sink as one NDJSON record, the message is acknowledged, the
# pidfile names the run, and a SIGINT ends it with exit 0, nothing on
# stdout and the pidfile gone.
#
# The session is registered by the session-start hook first (the map is
# the watcher's trust boundary). The three refusals come before the run.

# The `brigade` under test is the race-instrumented test binary too; without
# this every exec spends TSan's 1 s atexit sleep (see fake.sh).
env GORACE=atexit_sleep_ms=0
sleeper
env CLAUDE_PID=$SLEEPER_PID
env CLAUDE_CODE_SESSION_ID=native-1
env CLAUDECODE=1
env CLAUDE_PLUGIN_OPTION_ADAPTER_COMMAND='["'$WORK'/fake.sh","--script","'$WORK'/script.json"]'
expand script.json.in script.json
chmod 755 fake.sh
# On macOS the FIRST exec of a freshly created executable is suspended
# while the system assesses it — measured 2026-09-03: 0.2–0.5 s idle and
# 3–6 s while a whole-tree `go test` creates every package's binaries at
# once; the second exec costs ~10 ms. Both fake.sh (the file the harness
# execs) and the `fake-adapter` copy testscript installed are fresh, so
# the wrapper is run once here with no deadline, and the harness's 3 s
# describe budget (4.1) below meets warm files. (The `brigade` copy is
# warmed by its own first exec, which has no deadline.)
exec $WORK/fake.sh --script warm.json describe

# --- P7-6: the project owns the team; a real `team create` seeds the
# checkout, binding and pin (see hook-session-start.txtar).
mkdir $WORK/.brigade/xdg/config/brigade
expand adapters.json.in adapters.json.expanded
cp adapters.json.expanded $WORK/.brigade/xdg/config/brigade/adapters.json
chmod 600 $WORK/.brigade/xdg/config/brigade/adapters.json
expand script-create.json.in script-create.json
mkdir repo/.git
cd repo
env BRIGADE_CONFIG_DIR=$WORK/.brigade/xdg/config/brigade
env CLAUDE_PID=
exec brigade team create --adapter fake --url http://127.0.0.1:1 --key placeholder --name ops --secret-file $WORK/join.secret
env CLAUDE_PID=$SLEEPER_PID
cd $WORK
expand start.json.in start.json
expand end.json.in end.json
chmod 755 waitfile.sh
chmod 755 waitgrep.sh
stdin start.json
exec brigade hook session-start
stdout '\(brigade-sess-1\)'
grep '"socket_path":""' $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json
! exists $WORK/.brigade/xdg/state/brigade/watchers

# --- the hook-built environment (6.6): the six BRIGADE_* and the log level ---
env CLAUDE_PID=
env BRIGADE_CLAUDE_PID=$SLEEPER_PID
env BRIGADE_PROFILE=2e8074afe5f181510fc60ab1a91ed5eb
env BRIGADE_CONFIG_DIR=$WORK/.brigade/xdg/config/brigade
env BRIGADE_STATE_DIR=$WORK/.brigade/xdg/state/brigade
env BRIGADE_ADAPTER_COMMAND='["'$WORK'/fake.sh","--script","'$WORK'/script.json"]'
env BRIGADE_TEAM_INBOUND=accept
env BRIGADE_LOG_LEVEL=debug

# --- refusals: relative sink, sink with a socket, nothing to inject into ------
status 2 brigade watch --sink relative.ndjson
! stdout .
stderr '^brigade watch failed \(usage\): --sink must be an absolute path$'
env CLAUDE_CODE_MESSAGING_SOCKET=$WORK/never.sock
status 2 brigade watch --sink $WORK/sink.ndjson
stderr '^brigade watch failed \(usage\): --sink is refused while CLAUDE_CODE_MESSAGING_SOCKET is set'
env CLAUDE_CODE_MESSAGING_SOCKET=
status 11 brigade watch
stderr '^brigade watch failed \(config\): nothing to inject into'
! exists $WORK/sink.ndjson
! exists $WORK/.brigade/xdg/state/brigade/watchers
! exists $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log

# --- the run: one record in the sink, acked, the pidfile alive ----------------
exec brigade watch --sink $WORK/sink.ndjson &watcher&
# waitfile.sh is this script's Eventually: a bounded poll for a non-empty
# sink (30 s hang catcher, never a performance bound).
exec $WORK/waitfile.sh $WORK/sink.ndjson
json $WORK/sink.ndjson .message_id msg-1
json $WORK/sink.ndjson .sender_session_id cccccccccccccccccccccccccccccccc
grep 'cross-session-message from-name=' $WORK/sink.ndjson
grep 'brigade-message team=' $WORK/sink.ndjson
grep 'hello from the sink script' $WORK/sink.ndjson
grep -count=1 'message_id' $WORK/sink.ndjson
exists $WORK/.brigade/xdg/state/brigade/watchers/$SLEEPER_PID.json
grep '"brigade_session_id":"brigade-sess-1"' $WORK/.brigade/xdg/state/brigade/watchers/$SLEEPER_PID.json
grep '"socket_path":""' $WORK/.brigade/xdg/state/brigade/watchers/$SLEEPER_PID.json
grep '"token_sha256":""' $WORK/.brigade/xdg/state/brigade/watchers/$SLEEPER_PID.json
grep '"verb":"watch"' dump.ndjson
grep '"--session","brigade-sess-1"' dump.ndjson
grep '"BRIGADE_PROFILE":"2e8074afe5f181510fc60ab1a91ed5eb"' dump.ndjson
! grep BRIGADE_ADAPTER_COMMAND dump.ndjson
! grep BRIGADE_CLAUDE_PID dump.ndjson
# The ack follows the injection asynchronously (the `ack` command to the
# child, then the `acked` event back): the sink record proves the injection,
# not the ack, and a SIGINT sent the instant the sink filled won the race on
# the Ubuntu runner (CI run 33759439330). Wait for the ack line too.
exec $WORK/waitgrep.sh '"msg":"ack sent"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log

# --- SIGINT ends it: exit 0, silent streams, the pidfile released ------------
kill -INT watcher
wait watcher
! stdout .
! stderr .
! exists $WORK/.brigade/xdg/state/brigade/watchers/$SLEEPER_PID.json
grep '"msg":"watcher starting"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
grep '"mode":"sink"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
grep '"msg":"watch ready"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
grep '"msg":"injection reported"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
grep '"msg":"ack sent"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
grep '"msg":"watcher exiting","exit":0,"reason":"signal"' $WORK/.brigade/xdg/state/brigade/logs/watcher-$SLEEPER_PID.log
# The seen file is keyed by the Brigade session id (P5-14), never by the pid:
# the session-keyed file holds the id and no pid-keyed file was written.
grep msg-1 $WORK/.brigade/xdg/state/brigade/state/seen/brigade-sess-1.json
! exists $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.seen.json
# The sink still holds exactly the one record: nothing was injected twice.
grep -count=1 'message_id' $WORK/sink.ndjson

# --- the session is closed by the hook, as the SessionEnd hook would ------------
env CLAUDE_PID=$SLEEPER_PID
stdin end.json
exec brigade hook session-end
! exists $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json
grep '"verb":"close"' dump.ndjson

-- fake.sh --
#!/bin/sh
# The scripted fake adapter behind an absolute path (an adapter with a
# shebang line; the harness execs it, never a shell of its own).
# GORACE: under `go test -race` this fake is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit — not Brigade behaviour, but a third of the 3 s describe budget of
# 4.1 on a loaded machine (measured: every fake-adapter script timed out
# on describe under a whole-tree `make test`). The harness builds the
# child's environment from scratch, so the variable is set here, not in
# the script's environment.
GORACE=atexit_sleep_ms=0 exec fake-adapter "$@"
-- waitfile.sh --
#!/bin/sh
# A bounded poll for a non-empty file: 600 x 50 ms = 30 s, a hang catcher.
i=0
until [ -s "$1" ] || [ "$i" -ge 600 ]; do sleep 0.05; i=$((i+1)); done
[ -s "$1" ]
-- waitgrep.sh --
#!/bin/sh
# A bounded poll for a fixed string in a file: 600 x 50 ms = 30 s, a hang catcher.
i=0
until grep -qF -- "$1" "$2" 2>/dev/null || [ "$i" -ge 600 ]; do sleep 0.05; i=$((i+1)); done
grep -qF -- "$1" "$2"
-- start.json.in --
{"session_id": "native-1", "cwd": "$WORK/repo", "hook_event_name": "SessionStart", "source": "startup", "session_title": "payments-api", "transcript_path": "/never/read.jsonl"}
-- end.json.in --
{"session_id": "native-1", "cwd": "$WORK/repo", "hook_event_name": "SessionEnd", "reason": "other", "transcript_path": "/never/read.jsonl"}
-- script.json.in --
{"dump_file": "$WORK/dump.ndjson", "describe": {"protocol_version":"1","adapter":{"name":"fake-adapter","version":"0.0.0-fake"},"delivery":{"guarantee":"at_least_once","ordering":"none","ack_state":"injected"},"capabilities":["team.create","team.join","team.roster","message.receive","message.watch.push","message.watch.stdin_commands","session.description","session.resume","session.workspace_label","session.inbound"],"limits":{"max_body_bytes":16384,"max_summary_chars":200,"max_session_name_codepoints":64,"max_team_name_codepoints":64,"max_description_chars":256,"max_human_label_chars":128,"max_workspace_label_chars":128,"max_model_chars":128,"max_idempotency_key_chars":128,"send_rate":{"per_minute":20,"per_hour":200},"principal_send_rate":{"per_minute":60,"per_hour":600},"max_unacked_per_recipient":60,"max_unacked_per_sender_recipient":15,"max_hop_count":32,"implicit_reply_window_seconds":600},"lease":{"default_seconds":90,"min_seconds":30,"max_seconds":600},"retention":{"unacked_message_seconds":604800,"acked_message_seconds":86400,"closed_session_seconds":604800},"profile":{"name":"alpha","state":"joined","team_ref":"team-1","team_name":"ops","principal_ref":"principal-self","human_label":"me@example.com"}}, "responses": {"session register": [{"result": {"session_id":"brigade-sess-1","session_name":"payments-api","principal_ref":"principal-self","human_label":"me@example.com","state":"active","activity":"busy","inbound":"accept","last_seen_at":"2026-09-02T12:00:00Z","lease_until":"2026-09-02T12:01:30Z","created_at":"2026-09-02T12:00:00Z","is_self":true,"resumed":false,"lease_seconds":90,"server_time":"2026-09-02T12:00:00Z"}}], "session close": [{"result": {"session_id":"brigade-sess-1","state":"offline"}}]}, "watch": {"lines": [{"raw": {"event":"ready","protocol_version":"1","session_id":"brigade-sess-1","mode":"push"}}, {"raw": {"event":"message","message":{"protocol_version":"1","kind":"text","message_id":"msg-1","team_ref":"team-1","sender":{"principal_ref":"pr