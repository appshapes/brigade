# P1-1 smoke: the shipped binary driven as a real child process.
#
# Everything asserted here can only be observed across a process boundary —
# argv reaching the command table, stdin reaching a child, the exit status
# of 4.6, and the rule that nothing but protocol output ever goes to
# stdout. The in-process tests in internal/app and internal/cli cover the
# same code without a fork; this script is what proves the fork works.

# --- version --------------------------------------------------------------
# The human form is the bare version and nothing else. Byte-for-byte, not a
# regexp: `bin/brigade version` is asserted exactly by the Makefile and CI,
# so an extra banner line has to fail here too.
exec brigade version
cmp stdout want-version.txt
! stderr .

# The --json form puts the 4.3 envelope on stdout and leaves stderr empty.
exec brigade --json version
json stdout .ok true
json stdout .protocol_version 1
json stdout .result.version 0.0.0-testscript
! stderr .

# The comparison is exact, not a prefix: a truncated version must not pass.
! json stdout .result.version 0.0.0

# A field printed by one command becomes an argument to the next.
cp stdout version.json
jsonenv version.json .result.version VERSION
expand greeting.in greeting.out
cmp greeting.out greeting.want

# --- usage errors exit 2 ---------------------------------------------------
# An unknown command: exit 2, one line on stderr, nothing at all on stdout.
status 2 brigade no-such-command
! stdout .
stderr 'unknown command "no-such-command"'

# The same failure for a machine caller: the envelope on stdout, and now
# stderr is the stream that must stay empty.
status 2 brigade --json no-such-command
! stderr .
json stdout .ok false
json stdout .error.code usage
json stdout .error.retryable false

# An unknown flag is a usage error too, and the flag package's message must
# not reach stdout with it.
status 2 brigade version --no-such-flag
! stdout .
stderr 'invalid arguments'

# --- a recognised but unbuilt command is exit 1, not 2 ---------------------
# The distinction is the point: argv was right, the binary is incomplete.
status 1 brigade sessions
! stdout .
stderr 'not implemented yet'

# --- help succeeds on stdout ----------------------------------------------
exec brigade help
stdout 'Usage: brigade <command> \[arguments\]'
stdout 'sessions'
! stderr .

# --- the dev-only adapter binary is on the script PATH --------------------
# `make build` produces it; the conformance runner resolves it by name.
status 2 brigade-adapter-fs
json stdout .error.code usage
stderr 'brigade-adapter-fs'

# --- the scripted fake adapter (P3-2) -------------------------------------
# The P1-1 measuring instrument is gone; `fake-adapter` now speaks BAP/1,
# scripted by a JSON file named with a leading `--script`. `describe`
# answers a valid 4.3 envelope on stdout and writes nothing to stderr.
exec fake-adapter --script describe.json describe
json stdout .ok true
json stdout .protocol_version 1
json stdout .result.protocol_version 1
json stdout .result.adapter.name fake-adapter
! stderr .

# A script can make the fake dump the argv, stdin size and environment a
# child received, so the fork boundary stays observable. stdin reaches the
# child and the environment is the isolated one, never the developer's:
# HOME is testscript's /no-home so a stray ~ fails loudly, and
# CLAUDE_CONFIG_DIR is under $WORK, never ~/.claude.
expand dump.json.in dump.json
stdin body.txt
exec fake-adapter --script dump.json session register
json stdout .ok true
json dump.ndjson .group session
json dump.ndjson .verb register
json dump.ndjson .stdin_bytes 12
json dump.ndjson .env.HOME /no-home
json dump.ndjson .env.CLAUDE_CONFIG_DIR $WORK/.brigade/claude-config
json dump.ndjson .env.BRIGADE_STATE_DIR $WORK/.brigade/brigade-state
json dump.ndjson .env.BRIGADE_FS_ROOT $WORK/.brigade/fs-root

# A scripted error envelope carries its 4.6 exit status across the boundary,
# and the failing envelope is on stdout with the exit code the code names.
status 7 fake-adapter --script conflict.json team create
json stdout .ok false
json stdout .error.code conflict
json stdout .error.retryable false

-- want-version.txt --
0.0.0-testscript
-- body.txt --
a body line
-- greeting.in --
the version is $VERSION
-- greeting.want --
the version is 0.0.0-testscript
-- describe.json --
{}
-- dump.json.in --
{"dump_file": "$WORK/dump.ndjson", "responses": {"session register": [{"result": {"session_id": "s1"}}]}}
-- conflict.json --
{"responses": {"team create": [{"error": {"code": "conflict", "message": "already bound", "retryable": false}}]}}
