# `brigade whoami` through the real binary (P3-3, plan 6.4).
#
# The identity line from the map and the cached describe: exactly one
# child (the describe), no network; the --json form; and the two refusals
# — outside a session, and with a session map that is not private.

# --- fixture: the by-pid map the SessionStart hook would have written ----
# CLAUDE_PID is set, so every command resolves everything from the map
# under $XDG_STATE_HOME/brigade (never from the shell's BRIGADE_*), which
# names the scripted fake adapter behind an absolute path. The map is
# written 0600 by `expand`; the reader refuses anything else.
# The `brigade` under test is the race-instrumented test binary too; without
# this every exec spends TSan's 1 s atexit sleep (see fake.sh).
env GORACE=atexit_sleep_ms=0
env CLAUDE_PID=4242
mkdir $WORK/.brigade/xdg/state/brigade/sessions/by-pid
expand map.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
expand script.json.in script.json
chmod 755 fake.sh
# On macOS the FIRST exec of a freshly created executable is suspended
# while the system assesses it — measured 2026-09-03: 0.2–0.5 s idle and
# 3–6 s while a whole-tree `go test` creates every package's binaries at
# once; the second exec costs ~10 ms. Both fake.sh (the file the harness
# execs) and the `fake-adapter` copy testscript installed are fresh, so
# the wrapper is run once here with no deadline, and the harness's 3 s
# describe budget (4.1) below meets warm files. (The `brigade` copy is
# warmed by its own first exec, which has no deadline.)
exec $WORK/fake.sh --script warm.json describe

exec brigade whoami
cmp stdout want-whoami.txt
! stderr .
grep -count=1 '"group"' dump.ndjson
grep '"group":"describe"' dump.ndjson

exec brigade whoami --json
json stdout .ok true
json stdout .result.session_id aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
json stdout .result.session_name payments-api
json stdout .result.team_name ops
json stdout .result.profile alpha
json stdout .result.inbound accept
json stdout .result.adapter_name fake-adapter
json stdout .result.adapter_version 0.0.0-fake
json stdout .result.adapter_command.1 --script
json stdout .result.self_session_id aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
! stderr .

status 2 brigade whoami extra

# --- the plugin binary's path: the human form's second line, never --json ---
# Finding F1 took the path out of the SessionStart context line, so `whoami`
# is where a HUMAN reads it (docs/setup.md's symlink). The map above carries
# an empty plugin_bin, which is why want-whoami.txt is one line.
expand map-plugin-bin.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
expand want-whoami-terminal.in want-whoami-terminal.txt
exec brigade whoami
stdout '^session aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "payments-api" in team "ops" \(profile alpha, adapter fake-adapter 0.0.0-fake\); inbound: accept$'
stdout '^terminal: .*/plugin-root/bin/brigade$'
# The whole output, not two line patterns: the path is printed in FULL (the
# human copies it into a symlink) and the only line after it is the frame
# level (P5-12).
cmp stdout want-whoami-terminal.txt
! stderr .
exec brigade whoami --json
! stdout 'plugin-root'
! stdout 'terminal'

# --- a map that is not 0600 is refused: the E0-7 trust boundary --------------
chmod 644 $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
status 11 brigade whoami
stderr 'brigade whoami failed \(config\): the session map is not private'
status 11 brigade whoami --json
json stdout .error.code config
json stdout .error.details.reason map_not_private
json stdout .error.details.check insecure_mode
chmod 600 $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
exec brigade whoami

# --- outside a session -----------------------------------------------------
env CLAUDE_PID=
status 11 brigade whoami
stderr 'brigade whoami failed \(config\): brigade whoami needs a Brigade session'

-- map.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- map-plugin-bin.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "$WORK/.brigade/plugin-root/bin/brigade", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- fake.sh --
#!/bin/sh
# The scripted fake adapter behind an absolute path: the by-pid map needs
# one, and the testscript PATH entry that holds `fake-adapter` has no
# script variable. The harness execs this file; it is an adapter with a
# shebang line, not a shell the harness spawned.
# GORACE: under `go test -race` this fake is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit — not Brigade behaviour, but a third of the 3 s describe budget of
# 4.1 on a loaded machine (measured: every fake-adapter script timed out
# on describe under a whole-tree `make test`). The harness builds the
# child's environment from scratch, so the variable is set here, not in
# the script's environment.
GORACE=atexit_sleep_ms=0 exec fake-adapter "$@"
-- script.json.in --
{"dump_file": "$WORK/dump.ndjson"}
-- want-whoami.txt --
session aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "payments-api" in team "ops" (profile alpha, adapter fake-adapter 0.0.0-fake); inbound: accept
frame: open
-- want-whoami-terminal.in --
session aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa "payments-api" in team "ops" (profile alpha, adapter fake-adapter 0.0.0-fake); inbound: accept
terminal: $WORK/.brigade/plugin-root/bin/brigade
frame: open
-- warm.json --
{}
