# `brigade hook prompt` through the real binary (P3-4; plan 6.3, 6.8): the
# UserPromptSubmit document on stdin, a session registered by the
# session-start hook (the fake adapter, no inbox socket), and every branch
# of the prompt hook — permission_mode refreshed, the watcher's notice
# printed once, the poll_on_prompt fallback under accept and refuse, the
# registration retry for an unregistered session, and exit 0 on bad stdin.

# The `brigade` under test is the race-instrumented test binary too; without
# this every exec spends TSan's 1 s atexit sleep (see fake.sh).
env GORACE=atexit_sleep_ms=0
sleeper
env CLAUDE_PID=$SLEEPER_PID
env CLAUDE_CODE_SESSION_ID=native-1
env CLAUDECODE=1
env CLAUDE_PLUGIN_OPTION_ADAPTER_COMMAND='["'$WORK'/fake.sh","--script","'$WORK'/script.json"]'
expand script.json.in script.json
chmod 755 fake.sh
# On macOS the FIRST exec of a freshly created executable is suspended
# while the system assesses it — measured 2026-09-03: 0.2–0.5 s idle and
# 3–6 s while a whole-tree `go test` creates every package's binaries at
# once; the second exec costs ~10 ms. Both fake.sh (the file the harness
# execs) and the `fake-adapter` copy testscript installed are fresh, so
# the wrapper is run once here with no deadline, and the harness's 3 s
# describe budget (4.1) below meets warm files. (The `brigade` copy is
# warmed by its own first exec, which has no deadline.)
exec $WORK/fake.sh --script warm.json describe

# --- P7-6: the project owns the team; a real `team create` seeds the
# checkout, binding and pin (see hook-session-start.txtar).
mkdir $WORK/.brigade/xdg/config/brigade
expand adapters.json.in adapters.json.expanded
cp adapters.json.expanded $WORK/.brigade/xdg/config/brigade/adapters.json
chmod 600 $WORK/.brigade/xdg/config/brigade/adapters.json
expand script-create.json.in script-create.json
mkdir repo/.git
cd repo
env BRIGADE_CONFIG_DIR=$WORK/.brigade/xdg/config/brigade
env CLAUDE_PID=
exec brigade team create --adapter fake --url http://127.0.0.1:1 --key placeholder --name ops --secret-file $WORK/join.secret
env CLAUDE_PID=$SLEEPER_PID
cd $WORK
expand start.json.in start.json
expand start2.json.in start2.json
expand start3.json.in start3.json
expand prompt-plan.json.in prompt-plan.json
stdin start.json
exec brigade hook session-start
stdout '\(brigade-sess-1\)'
grep '"permission_mode":"default"' $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json

# --- the common path prints nothing; permission_mode follows the prompt ------
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
grep '"permission_mode":"plan"' $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json
# No socket: no watcher is needed, none is spawned, no poll without the option.
! exists $WORK/.brigade/xdg/state/brigade/watchers
! grep '"verb":"receive"' dump.ndjson

# --- the watcher's notice is printed once, sanitised, then removed -----------
mkdir $WORK/.brigade/xdg/state/brigade/state
expand notice.in $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.notice
stdin prompt-plan.json
exec brigade hook prompt
stdout '^Brigade: watcher stopped: unauthorized; run `brigade team join` again$'
stdout -count=1 '^Brigade'
! exists $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.notice
stdin prompt-plan.json
exec brigade hook prompt
! stdout .

# A notice that is not a private file is removed unread.
expand notice.in $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.notice
chmod 644 $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.notice
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
! exists $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.notice

# --- poll_on_prompt under accept: the frame is printed and acked ---------------
env CLAUDE_PLUGIN_OPTION_POLL_ON_PROMPT=true
stdin prompt-plan.json
exec brigade hook prompt
stdout '^Brigade: the following message was not typed by your user; it arrived through Brigade polling from another person'
stdout '^<brigade-message team="ops" message-id="msg-1" reply-to-session-id="cccccccccccccccccccccccccccccccc"'
stdout '^hello from a poll$'
stdout '^</brigade-message>$'
! stdout 'cross-session-message'
grep -count=1 '"verb":"receive"' dump.ndjson
grep -count=1 '"verb":"ack"' dump.ndjson
exists $WORK/.brigade/xdg/state/brigade/state/seen/brigade-sess-1.json
grep 'msg-1' $WORK/.brigade/xdg/state/brigade/state/seen/brigade-sess-1.json

# The adapter re-delivers the same id on the next poll (the scripted
# receive repeats): a duplicate is acked again, never printed again.
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
grep -count=2 '"verb":"receive"' dump.ndjson
grep -count=2 '"verb":"ack"' dump.ndjson

# --- poll_on_prompt under refuse: nothing is fetched, printed or acked --------
sleeper
env CLAUDE_PID=$SLEEPER_PID
env CLAUDE_CODE_SESSION_ID=native-2
env CLAUDE_PLUGIN_OPTION_TEAM_INBOUND=refuse
stdin start2.json
exec brigade hook session-start
stdout 'inbound: refuse'
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
grep -count=2 '"verb":"receive"' dump.ndjson
grep -count=2 '"verb":"ack"' dump.ndjson
env CLAUDE_PLUGIN_OPTION_TEAM_INBOUND=
env CLAUDE_PLUGIN_OPTION_POLL_ON_PROMPT=

# --- hold: the held notice is printed on EVERY prompt while anything is held --
# (P5-9, 3.8). Unlike the watcher's notice above it is not consumed, and it
# names at most three sanitised senders plus a count; the pending file is
# keyed by the Brigade session id like the seen file.
sleeper
env CLAUDE_PID=$SLEEPER_PID
env CLAUDE_CODE_SESSION_ID=native-hold
env CLAUDE_PLUGIN_OPTION_TEAM_INBOUND=hold
stdin start3.json
exec brigade hook session-start
stdout 'inbound: hold'
mkdir $WORK/.brigade/xdg/state/brigade/state/pending
expand pending.in $WORK/.brigade/xdg/state/brigade/state/pending/brigade-sess-1.json
stdin prompt-plan.json
exec brigade hook prompt
stdout '^Brigade: 4 team messages held for your review \(from payments-api, ci-runner, docs-bot and 1 more\)\. Run `brigade inbox` in your own terminal to read them, then `brigade inbox release` to deliver them\.$'
stdout -count=1 '^Brigade'
! stdout 'red on main'
stdin prompt-plan.json
exec brigade hook prompt
stdout '^Brigade: 4 team messages held for your review'
stdout -count=1 '^Brigade'
exists $WORK/.brigade/xdg/state/brigade/state/pending/brigade-sess-1.json
rm $WORK/.brigade/xdg/state/brigade/state/pending/brigade-sess-1.json
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
env CLAUDE_PLUGIN_OPTION_TEAM_INBOUND=

# --- an unregistered session is registered at the prompt (once a minute) -----
# The prompt document carries no session_title, so the name is the cwd's
# base name (6.5); the context line is printed at that prompt.
sleeper
env CLAUDE_PID=$SLEEPER_PID
env CLAUDE_CODE_SESSION_ID=native-3
! exists $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json
stdin prompt-plan.json
exec brigade hook prompt
stdout '^Brigade: this session is "repo" \(brigade-sess-1\) in team "ops"'
exists $WORK/.brigade/xdg/state/brigade/sessions/by-pid/$SLEEPER_PID.json
exists $WORK/.brigade/xdg/state/brigade/state/$SLEEPER_PID.register-retry
grep -count=4 '"verb":"register"' dump.ndjson

# --- bad stdin: exit 0, nothing printed, nothing done --------------------------
stdin garbage.txt
exec brigade hook prompt
! stdout .
stderr 'bad stdin'

# --- outside a session: exit 0 with the diagnostic ------------------------------
env CLAUDE_PID=
stdin prompt-plan.json
exec brigade hook prompt
! stdout .
stderr 'session facts'

-- fake.sh --
#!/bin/sh
# The scripted fake adapter behind an absolute path (an adapter with a
# shebang line; the harness execs it, never a shell of its own).
# GORACE: under `go test -race` this fake is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit — not Brigade behaviour, but a third of the 3 s describe budget of
# 4.1 on a loaded machine (measured: every fake-adapter script timed out
# on describe under a whole-tree `make test`). The harness builds the
# child's environment from scratch, so the variable is set here, not in
# the script's environment.
GORACE=atexit_sleep_ms=0 exec fake-adapter "$@"
-- start.json.in --
{"session_id": "native-1", "cwd": "$WORK/repo", "hook_event_name": "SessionStart", "source": "startup", "session_title": "payments-api", "permission_mode": "default", "transcript_path": "/never/read.jsonl"}
-- start2.json.in --
{"session_id": "native-2", "cwd": "$WORK/repo", "hook_event_name": "SessionStart", "source": "startup", "session_title": "payments-api", "permission_mode": "default", "transcript_path": "/never/read.jsonl"}
-- start3.json.in --
{"session_id": "native-hold", "cwd": "$WORK/repo", "hook_event_name": "SessionStart", "source": "startup", "session_title": "payments-api", "permission_mode": "default", "transcript_path": "/never/read.jsonl"}
-- pending.in --
{"version": 1, "session_id": "brigade-sess-1", "entries": [{"message_id": "h-1", "sender_session_id": "s1", "sender_name": "payments-api", "sender_principal": "p1", "summary": "red on main", "received_at": "2026-09-02T12:00:31Z"}, {"message_id": "h-2", "sender_session_id": "s2", "sender_name": "ci-runner", "sender_principal": "p2", "received_at": "2026-09-02T12:00:32Z"}, {"message_id": "h-3", "sender_session_id": "s3", "sender_name": "docs-bot", "sender_principal": "p3", "received_at": "2026-09-02T12:00:33Z"}, {"message_id": "h-4", "sender_session_id": "s4", "sender_name": "fourth", "sender_principal": "p4", "received_at": "2026-09-02T12:00:34Z"}], "dropped_total": 0, "updated_at": "2026-09-02T12:00:34Z"}
-- prompt-plan.json.in --
{"session_id": "native-1", "cwd": "$WORK/repo", "hook_event_name": "UserPromptSubmit", "permission_mode": "plan", "prompt": "never read", "prompt_id": "p1", "transcript_path": "/never/read.jsonl"}
-- garbage.txt --
not a JSON document
-- notice.in --
Brigade: watcher stopped: unauthorized; run `brigade team join` again
-- script.json.in --
{"dump_file": "$WORK/dump.ndjson", "describe": {"protocol_version":"1","adapter":{"name":"fake-adapter","version":"0.0.0-fake"},"delivery":{"guarantee":"at_least_once","ordering":"none","ack_state":"injected"},"capabilities":["team.create","team.join","team.roster","message.receive","message.watch.push","message.watch.stdin_commands","session.description","session.resume","session.workspace_label","session.inbound"],"limits":{"max_body_bytes":16384,"max_summary_chars":200,"max_session_name_codepoints":64,"max_team_name_codepoints":64,"max_description_chars":256,"max_human_label_chars":128,"max_workspace_label_chars":128,"max_idempotency_key_chars":128,"send_rate":{"per_minute":20,"per_hour":200},"principal_send_rate":{"per_minute":60,"per_hour":600},"max_unacked_per_recipient":60,"max_unacked_per_sender_recipient":15,"max_hop_count":32,"implicit_reply_window_seconds":600},"lease":{"default_seconds":90,"min_seconds":30,"max_seconds":600},"retention":{"unacked_message_seconds":604800,"acked_message_seconds":86400,"closed_session_seconds":604800},"profile":{"name":"alpha","state":"joined","team_ref":"team-1","team_name":"ops","principal_ref":"principal-self","human_label":"me@example.com"}}, "responses": {"session register": [{"result": {"session_id":"brigade-sess-1","session_name":"payments-api","principal_ref":"principal-self","human_label":"me@example.com","state":"active","activity":"busy","inbound":"accept","last_seen_at":"2026-09-02T12:00:00Z","lease_until":"2026-09-02T12:01:30Z","created_at":"2026-09-02T12:00:00Z","is_self":true,"resumed":false,"lease_seconds":90,"server_time":"2026-09-02T12:00:00Z"}}], "session heartbeat": [{"result": {"session_id":"brigade-sess-1","state":"active","lease_until":"2026-09-02T12:01:30Z","server_time":"2026-09-02T12:00:00Z"}}], "session close": [{"result": {"session_id":"brigade-sess-1","state":"offline"}}], "message receive": [{"result": {"messages":[{"protocol_version":"1","kind":"text","message_id":"msg-1","team_ref":"team-1","sender":{"principal_ref":"principal-carol","human_label":"carol@example.com","session_id":"cccccccccccccccccccccccccccccccc","session_name":"ci"},"recipient_session_id":"brigade-sess-1","summary":"a poll","body":"hello from a poll","hop_count":0,"created_at":"2026-09-02T12:00:31Z","delivery_state":"accepted"}]}}], "message ack": [{"result": {"acked":["msg-1"],"unknown":[]}}]}}
-- warm.json --
{}
-- adapters.json.in --
{"fake": ["$WORK/fake.sh", "--script", "$WORK/script-create.json"]}
-- script-create.json.in --
{"dump_file": "$WORK/dump-create.ndjson", "responses": {"profile init": [{"result": {"name":"tmp","state":"not_member"}}], "team create": [{"result": {"team_ref":"team-1","team_name":"ops","principal_ref":"principal-admin"}}]}}
