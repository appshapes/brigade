# `brigade send` through the real binary (P3-3, plan 6.4, 3.4).
#
# U-05 first: an oversize body and an empty body are refused with exit 3
# BEFORE any spawn — the fake adapter's dump file, which every child
# appends to, does not exist afterwards. Then the body on stdin, the body
# from a file, the confirmation line, the --json result, and the request
# document the adapter received (sender from the map, the D11 key present).

# --- fixture: the by-pid map the SessionStart hook would have written ----
# CLAUDE_PID is set, so every command resolves everything from the map
# under $XDG_STATE_HOME/brigade (never from the shell's BRIGADE_*), which
# names the scripted fake adapter behind an absolute path. The map is
# written 0600 by `expand`; the reader refuses anything else.
# The `brigade` under test is the race-instrumented test binary too; without
# this every exec spends TSan's 1 s atexit sleep (see fake.sh).
env GORACE=atexit_sleep_ms=0
env CLAUDE_PID=4242
mkdir $WORK/.brigade/xdg/state/brigade/sessions/by-pid
expand map.in $WORK/.brigade/xdg/state/brigade/sessions/by-pid/4242.json
expand script.json.in script.json
chmod 755 fake.sh
# On macOS the FIRST exec of a freshly created executable is suspended
# while the system assesses it — measured 2026-09-03: 0.2–0.5 s idle and
# 3–6 s while a whole-tree `go test` creates every package's binaries at
# once; the second exec costs ~10 ms. Both fake.sh (the file the harness
# execs) and the `fake-adapter` copy testscript installed are fresh, so
# the wrapper is run once here with no deadline, and the harness's 3 s
# describe budget (4.1) below meets warm files. (The `brigade` copy is
# warmed by its own first exec, which has no deadline.)
exec $WORK/fake.sh --script warm.json describe

# --- an oversize body (16,385 bytes: one past the cap) spawns nothing ----------
stdin big.txt
status 3 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
! stdout .
stderr 'brigade send failed \(invalid_input\): the body is longer than the protocol allows'
! exists $WORK/dump.ndjson

# The same refusal as an envelope carries the 4.3.1 details.
stdin big.txt
status 3 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb --json
! stderr .
json stdout .ok false
json stdout .error.code invalid_input
json stdout .error.details.field body
json stdout .error.details.reason too_long
json stdout .error.details.limit 16384
json stdout .error.details.actual 16385
json stdout .error.details.unit bytes
! exists $WORK/dump.ndjson

# --- an empty body spawns nothing either -------------------------------------
stdin empty.txt
status 3 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stderr 'brigade send failed \(invalid_input\): the body is empty'
! exists $WORK/dump.ndjson

# A missing recipient is usage, still with nothing spawned.
stdin body.txt
status 2 brigade send
stderr 'brigade send failed \(usage\)'
! exists $WORK/dump.ndjson

# --- the body on stdin (a heredoc in the Bash tool) ----------------------------
stdin body.txt
exec brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb --summary 'migration completed'
cmp stdout want-accepted.txt
! stderr .
exists $WORK/dump.ndjson

# The adapter received `message send` under the map's profile, with the
# request document on its stdin (the describe before it took none).
grep '"verb":"send","args":\[\],"stdin_bytes":[1-9]' dump.ndjson
grep '"group":"describe","verb":"","args":\[\],"stdin_bytes":0' dump.ndjson
grep '"--profile","alpha"' dump.ndjson

# --- the same body again is the adapter's duplicate ---------------------------
stdin body.txt
exec brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stdout '^accepted: message msg-0001 to bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb, duplicate of an earlier send\. Accepted means durably stored by the adapter, not read\.$'

# --- --body-file, and the --json result ---------------------------------------
exec brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb --body-file body.txt --reply-to msg-0000 --json
! stderr .
json stdout .ok true
json stdout .result.status accepted
json stdout .result.message_id msg-0001
json stdout .result.recipient_session_id bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
json stdout .result.self_session_id aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
json stdout .result.note 'Accepted means durably stored by the adapter, not read.'

# --- outside a session there is no sender: config, nothing spawned -------------
env CLAUDE_PID=
rm $WORK/dump.ndjson
stdin body.txt
status 11 brigade send bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
stderr 'brigade send failed \(config\)'
! exists $WORK/dump.ndjson

-- map.in --
{"claude_pid": 4242, "claude_session_id": "native-1", "brigade_session_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "team_ref": "team-1", "team_name": "ops", "session_name": "payments-api", "permission_mode": "default", "non_interactive": false, "inbound": "accept", "frame_level": "open", "frame_text": "", "socket_path": "", "team_key": "alpha", "config_dir": "$WORK/.brigade/brigade-config", "adapter_command": ["$WORK/fake.sh", "--script", "$WORK/script.json"], "plugin_bin": "", "harness_version": "2.1.251", "registered_at": "2026-09-02T12:00:00Z", "updated_at": "2026-09-02T12:00:00Z"}
-- fake.sh --
#!/bin/sh
# The scripted fake adapter behind an absolute path: the by-pid map needs
# one, and the testscript PATH entry that holds `fake-adapter` has no
# script variable. The harness execs this file; it is an adapter with a
# shebang line, not a shell the harness spawned.
# GORACE: under `go test -race` this fake is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit — not Brigade behaviour, but a third of the 3 s describe budget of
# 4.1 on a loaded machine (measured: every fake-adapter script timed out
# on describe under a whole-tree `make test`). The harness builds the
# child's environment from scratch, so the variable is set here, not in
# the script's environment.
GORACE=atexit_sleep_ms=0 exec fake-adapter "$@"
-- script.json.in --
{"dump_file": "$WORK/dump.ndjson", "responses": {"message send": [{"result": {"status": "accepted", "message_id": "msg-0001", "recipient_session_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "created_at": "2026-09-02T12:00:31Z", "duplicate": false, "hop_count": 0}}, {"result": {"status": "accepted", "message_id": "msg-0001", "recipient_session_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "created_at": "2026-09-02T12:00:31Z", "duplicate": true, "hop_count": 0}}]}}
-- body.txt --
the tenant_id migration has landed
-- empty.txt --
-- want-accepted.txt --
accepted: message msg-0001 to bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb. Accepted means durably stored by the adapter, not read.
