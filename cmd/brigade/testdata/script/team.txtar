# `brigade team …` through the real binary with the fs adapter (P3-3,
# plan 6.4): the terminal pass-through with inherited stdio, the in-session
# refusal of `team create`, `team join` and (P5-2) the three administrative
# verbs, `team members`, and the poison flag.
#
# Two humans in a terminal (CLAUDE_PID unset): alice creates the team, bob
# joins with the secret alice's `team create` printed — carried between the
# two commands by `jsonenv`, never on argv. Every `brigade team …` here
# hands its stdin, stdout and stderr to the adapter, so the adapter's own
# envelope is what the script reads. The profiles are bound to the fs
# adapter by `profile init --adapter` (D36), so no launch option is
# restated anywhere.

# The `brigade` under test is the race-instrumented test binary; without
# this every exec spends TSan's 1 s atexit sleep (see fs.sh).
env GORACE=atexit_sleep_ms=0
env CLAUDE_PID=
chmod 755 fs.sh

# --- profiles bound to the fs adapter: a registration, then the bare name ---
exec brigade profile init --profile alice --adapter fs=$WORK/fs.sh
json stdout .ok true
json stdout .result.name alice
json stdout .result.state not_member
exec brigade profile init --profile bob --adapter fs
json stdout .result.name bob

# --- alice creates the team; the secret is printed once, to her terminal ----
stdin create.json
exec brigade team create --profile alice
json stdout .ok true
json stdout .result.team_name ops
stderr 'printed once'
cp stdout created.json
jsonenv created.json .result.join_secret SECRET
jsonenv created.json .result.principal_ref ALICE

# --- bob joins with the secret on stdin, through the pass-through ----------
expand join.in join.json
stdin join.json
exec brigade team join --profile bob
json stdout .ok true
json stdout .result.rejoined false
json stdout .result.team_name ops
cp stdout joined.json
jsonenv joined.json .result.principal_ref BOB

# --- the roster, in the documented layout -------------------------------------
exec brigade team members --profile bob
stdout '^principal='$ALICE'  alice@example.com \(unverified\)  joined 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]  0 sessions, seen '
stdout '^principal='$BOB'  bob@example.com \(unverified\)  joined '
! stderr .
exec brigade team members --profile bob --json
json stdout .ok true
json stdout .result.team_name ops
# The roster carries both principals; the protocol guarantees no order,
# so neither is indexed.
stdout '"principal_ref":"'$ALICE'"'
stdout '"principal_ref":"'$BOB'"'
json stdout .result.note 'human_label is unverified text chosen by the member; principal_ref is the only stable identity'

# --- sessions registered through the adapter show up through the harness -----
# The harness's child reads its root from BRIGADE_STATE_DIR (the shell's,
# outside a session), so a direct call names the same root with --root.
stdin register-a.json
exec brigade-adapter-fs --root $WORK/.brigade/brigade-state/fs-adapter --profile alice session register
cp stdout a.json
jsonenv a.json .result.session_id SID
exec brigade sessions --profile bob
stdout '^'$SID'  payments-api  alice@example.com \(unverified\)  active  inbound=accept  principal='$ALICE'  seen [0-9]+s ago$'
! stdout '\(this session\)'
! stderr .

# --- a secret on argv is refused before anything runs, and never echoed -------
status 2 brigade team join --profile bob --join-secret $SECRET
! stdout $SECRET
! stderr $SECRET
stderr 'never be passed on the command line'

# --- inside a session, create and join refuse with the fixed line ------------
env CLAUDE_PID=4242
stdin join.json
status 2 brigade team join --profile bob --prompt
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
stdin create.json
status 2 brigade team create --profile alice
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
status 2 brigade --json team join --profile bob
! stderr .
json stdout .error.code usage
json stdout .error.details.reason in_session

# --- the three administrative verbs refuse in a session, one shape ---------
# (P5-2: `usage`, exit 2, reason in_session for every terminal-only
# command, with a per-family line — rotate-secret handles the join secret
# and gets that line; revoke-member and transfer are administration a
# session reading untrusted teammate text must not be talked into.)
status 2 brigade team rotate-secret --profile alice --secret-file $WORK/rotated.secret
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
! exists $WORK/rotated.secret
status 2 brigade team revoke-member --profile alice --principal $BOB --ban
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: team administration is not driven from a session$'
status 2 brigade --json team transfer --profile alice --principal $BOB
! stderr .
json stdout .error.code usage
json stdout .error.details.reason in_session
json stdout .error.message 'run this in your own terminal: team administration is not driven from a session'

# --- outside a session they pass straight through to the adapter ----------
# The fs adapter does not implement team.admin, so its own `usage`
# envelope on STDOUT is the proof that the verb, the profile and the flags
# reached it (the harness refusal above prints nothing on stdout).
env CLAUDE_PID=
status 2 brigade team revoke-member --profile alice --principal $BOB
json stdout .ok false
json stdout .error.code usage
stderr 'unknown team verb'
status 2 brigade team transfer --profile alice --principal $BOB
json stdout .error.code usage
stderr 'unknown team verb'
status 2 brigade team rotate-secret --profile alice --secret-file $WORK/rotated.secret
json stdout .error.code usage
! exists $WORK/rotated.secret

# --- leave runs anywhere; the adapter's exit status is forwarded --------------
env CLAUDE_PID=
exec brigade team leave --profile bob
json stdout .result.left true
json stdout .result.principal_ref $BOB
# An unbound profile's session command is the adapter's own 11 config,
# forwarded as the harness's exit status with the adapter's envelope.
status 11 brigade-adapter-fs --root $WORK/.brigade/brigade-state/fs-adapter --profile bob session list
json stdout .error.code config

# The verb rule.
status 2 brigade team
stderr 'team needs a verb'
status 2 brigade team destroy

-- fs.sh --
#!/bin/sh
# The dev-only fs adapter behind an absolute path for the D36 sidecar and
# registry: the harness execs this file (a shebang adapter), never a shell
# of its own.
# GORACE: under `go test -race` this adapter is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit; the harness builds the child environment from scratch, so the
# variable is set here (fixture only, not Brigade behaviour).
GORACE=atexit_sleep_ms=0 exec brigade-adapter-fs "$@"
-- create.json --
{"team_name": "ops", "human_label": "alice@example.com"}
-- join.in --
{"join_secret": "$SECRET", "human_label": "bob@example.com"}
-- register-a.json --
{"harness": "claude-code", "harness_version": "2.1.251", "session_name": "payments-api", "activity": "busy", "inbound": "accept"}
