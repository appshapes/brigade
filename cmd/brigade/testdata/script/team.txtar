# `brigade team …` through the real binary with the fs adapter (P3-3,
# plan 6.4; reworked for P7-7: the project owns the team). Alice's NEW
# `team create` runs in a checkout and writes `.brigade.json`, her
# binding and her pin; bob joins through the fully explicit non-TTY
# stdin pass-through into HIS OWN store (two principals of one team
# cannot share a key-keyed credential dir), resolved by the chain (his
# store's sole team). The in-session refusals, the poison flag, the
# roster and the admin pass-throughs keep their old assertions.

# The `brigade` under test is the race-instrumented test binary; without
# this every exec spends TSan's 1 s atexit sleep (see fs.sh).
env GORACE=atexit_sleep_ms=0
env CLAUDE_PID=
chmod 755 fs.sh
chmod 755 mkjoin.sh

# --- the fs adapter registered by NAME in both stores (P7-6: names
# resolve through adapters.json, never through sidecars) ---------------
mkdir $WORK/.brigade/brigade-config
expand registry.in registry.json
cp registry.json $WORK/.brigade/brigade-config/adapters.json
chmod 600 $WORK/.brigade/brigade-config/adapters.json
mkdir $WORK/bob-config
cp registry.json $WORK/bob-config/adapters.json
chmod 600 $WORK/bob-config/adapters.json

# --- alice creates the team IN A CHECKOUT: one command, the file, the
# binding, the pin; the secret goes to the 0600 file, never stdout ------
mkdir repo/.git
cd repo
exec brigade team create --adapter fs --url http://127.0.0.1:1 --key placeholder --name ops --label alice@example.com --secret-file $WORK/team.secret
stdout 'created team "ops"'
stdout 'wrote .*\.brigade\.json'
stdout 'git add \.brigade\.json'
! stdout brg1
exists $WORK/repo/.brigade.json
exists $WORK/team.secret
cd $WORK

# --- a relative --secret-file refuses before any work (the archived
# DECISIVE finding: it would land the secret inside the repository) -----
cd repo
status 2 brigade team create --adapter fs --url http://127.0.0.1:1 --key placeholder --name other --secret-file rel.secret
stderr 'must be an absolute path outside this project'
! exists rel.secret
cd $WORK

# --- bob joins through the explicit stdin document, into his own store;
# the repo file is never opened on this path (correction 7) -------------
exec sh mkjoin.sh $WORK/team.secret join.json
stdin join.json
env BRIGADE_CONFIG_DIR=$WORK/bob-config
exec brigade team join --adapter fs
json stdout .ok true
json stdout .result.rejoined false
json stdout .result.team_name ops
cp stdout joined.json
jsonenv joined.json .result.principal_ref BOB

# --- the roster, in the documented layout (bob's store, sole team) -----
exec brigade team members
stdout 'alice@example.com \(unverified\)  joined 20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]'
stdout '^principal='$BOB'  bob@example.com \(unverified\)  joined '
! stderr .
exec brigade team members --json
json stdout .ok true
json stdout .result.team_name ops
stdout '"principal_ref":"'$BOB'"'
json stdout .result.note 'human_label is unverified text chosen by the member; principal_ref is the only stable identity'

# --- sessions registered through the adapter show up through the harness -----
stdin register-a.json
exec brigade-adapter-fs --root $WORK/.brigade/brigade-state/fs-adapter --profile default session register
cp stdout a.json
jsonenv a.json .result.session_id SID
exec brigade sessions
stdout '^'$SID'  payments-api  bob@example.com \(unverified\)  active  inbound=accept'
! stdout '\(this session\)'
! stderr .

# --- a secret on argv is refused before anything runs, and never echoed -------
status 2 brigade team join --join-secret brg1.team-x.notreal-but-poisoned
! stdout brg1.team-x
! stderr brg1.team-x
stderr 'never be passed on the command line'

# --- inside a session, create and join refuse with the fixed line ------------
env CLAUDE_PID=4242
stdin join.json
status 2 brigade team join --prompt
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
stdin create.json
status 2 brigade team create
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
status 2 brigade --json team join
! stderr .
json stdout .error.code usage
json stdout .error.details.reason in_session

# --- the three administrative verbs refuse in a session, one shape ---------
status 2 brigade team rotate-secret --secret-file $WORK/rotated.secret
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: the join secret must never pass through the chat$'
! exists $WORK/rotated.secret
status 2 brigade team revoke-member --principal $BOB --ban
! stdout .
stderr '^brigade team failed \(usage\): run this in your own terminal: team administration is not driven from a session$'
status 2 brigade --json team transfer --principal $BOB
! stderr .
json stdout .error.code usage
json stdout .error.details.reason in_session
json stdout .error.message 'run this in your own terminal: team administration is not driven from a session'

# --- outside a session they pass straight through to the adapter ----------
# The fs adapter does not implement team.admin, so its own `usage`
# envelope on STDOUT is the proof that the verb and the flags reached it
# (the harness refusal above prints nothing on stdout).
env CLAUDE_PID=
status 2 brigade team revoke-member --principal $BOB
json stdout .ok false
json stdout .error.code usage
stderr 'unknown team verb'
status 2 brigade team transfer --principal $BOB
json stdout .error.code usage
stderr 'unknown team verb'
status 2 brigade team rotate-secret --secret-file $WORK/rotated.secret
json stdout .error.code usage
! exists $WORK/rotated.secret

# --- leave runs anywhere; the adapter's exit status is forwarded --------------
exec brigade team leave
json stdout .result.left true
json stdout .result.principal_ref $BOB
# A left store's session command is the adapter's own 11 config,
# forwarded as the harness's exit status with the adapter's envelope.
status 11 brigade-adapter-fs --root $WORK/.brigade/brigade-state/fs-adapter --profile default session list
json stdout .error.code config

# The verb rule.
status 2 brigade team
stderr 'team needs a verb'
status 2 brigade team destroy

-- fs.sh --
#!/bin/sh
# The dev-only fs adapter behind an absolute path for the adapters.json
# registry: the harness execs this file (a shebang adapter), never a
# shell of its own.
# GORACE: under `go test -race` this adapter is the race-instrumented test
# binary, and TSan sleeps atexit_sleep_ms (1 s by default) before every
# exit; the harness builds the child environment from scratch, so the
# variable is set here (fixture only, not Brigade behaviour).
GORACE=atexit_sleep_ms=0 exec brigade-adapter-fs "$@"
-- mkjoin.sh --
#!/bin/sh
# Builds bob's join document from the 0600 secret file: the secret never
# rides argv and never a shell variable in the SCRIPT under test — this
# fixture is the password-manager hand-off, off screen.
secret=$(cat "$1")
printf '{"join_secret":"%s","human_label":"bob@example.com"}\n' "$secret" > "$2"
-- registry.in --
{"fs": ["$WORK/fs.sh"]}
-- create.json --
{"team_name": "ops", "human_label": "alice@example.com"}
-- register-a.json --
{"harness": "claude-code", "harness_version": "2.1.251", "session_name": "payments-api", "activity": "busy", "inbound": "accept"}
