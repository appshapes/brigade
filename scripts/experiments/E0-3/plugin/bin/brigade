#!/usr/bin/env python3
"""E0-3 fake `brigade` executable.

Stands in for the real Brigade CLI on the Bash tool's PATH (the plugin bin/ is
appended to PATH). Its only job is to RECORD what the nested model tried to do
and to look like it succeeded, so E0-3 check (c) can see whether the model sent
a reply and check (a) can see HOW it invoked the binary.

Records one NDJSON line per invocation:
  argv, argv0 (so full-path or `sh -c` calls are visible), cmd, the parsed
  positional session_id, the --reply-to value, the body (heredoc on stdin, else
  argv), the body source, cwd, and a timestamp.

Always records, whatever argv[0] is (bare name via PATH, absolute path, or
through `sh -c`). Exits 0 and prints a plausible success line.
"""
import os, sys, json, datetime, uuid

self_path = os.path.realpath(__file__)
root = os.path.dirname(os.path.dirname(self_path))  # bin/.. == plugin root
state = os.path.join(root, "state")
os.makedirs(state, exist_ok=True)
logpath = os.environ.get("BRIGADE_E03_FAKE_LOG", os.path.join(state, "fake-brigade.ndjson"))

argv = list(sys.argv)
cmd = argv[1] if len(argv) > 1 else ""

# Parse `send <session_id> --reply-to <id> [body...]` loosely.
reply_to = None
positionals = []
i = 2
while i < len(argv):
    a = argv[i]
    if a == "--reply-to":
        i += 1
        reply_to = argv[i] if i < len(argv) else None
    elif a.startswith("--reply-to="):
        reply_to = a.split("=", 1)[1]
    elif a.startswith("-"):
        # Unknown flag; do not guess whether it takes a value.
        pass
    else:
        positionals.append(a)
    i += 1

session_id = positionals[0] if positionals else None
body_argv = positionals[1:] if len(positionals) > 1 else []

# Body: prefer heredoc/piped stdin, fall back to argv remainder. Guard the read
# with select so an invocation with NO redirected stdin (argv body, or a Bash
# tool that leaves stdin an open-but-empty pipe) does not block forever; a
# heredoc has its bytes ready immediately, so it is seen at once.
import select

stdin_body = ""
try:
    if not sys.stdin.isatty():
        r, _, _ = select.select([sys.stdin], [], [], 0.5)
        if r:
            stdin_body = sys.stdin.read()
except Exception:
    stdin_body = ""

if stdin_body.strip():
    body = stdin_body
    body_source = "stdin"
else:
    body = " ".join(body_argv)
    body_source = "argv"

rec = {
    "ts": datetime.datetime.now().astimezone().isoformat(),
    "cmd": cmd,
    "argv": argv,
    "argv0": argv[0],
    "session_id": session_id,
    "reply_to": reply_to,
    "body": body,
    "body_source": body_source,
    "cwd": os.getcwd(),
    "claude_session": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
    "claude_pid": os.environ.get("CLAUDE_PID", ""),
}
with open(logpath, "a") as f:
    f.write(json.dumps(rec) + "\n")

if cmd == "send":
    print(f"Message delivered. message_id={uuid.uuid4()}")
else:
    print("ok")
sys.exit(0)
