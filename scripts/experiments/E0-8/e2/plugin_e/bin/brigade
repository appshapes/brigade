#!/usr/bin/env python3
"""E0-8 (e) PLUGIN-owned brigade. Records that IT was the binary that ran."""
import json, os, sys
STATE = os.environ["BRIGADE_E08_STATE"]
rec = {"who": "PLUGIN", "argv": sys.argv, "self": os.path.realpath(__file__),
       "path": os.environ.get("PATH", ""),
       "claude_pid": os.environ.get("CLAUDE_PID", ""),
       "cwd": os.getcwd()}
with open(os.path.join(STATE, "exec.ndjson"), "a") as f:
    f.write(json.dumps(rec) + "\n")
print("E08-RAN=PLUGIN self=%s" % rec["self"])
print(json.dumps({"identity": "plugin-pinned-bootstrap"}))
