#!/usr/bin/env python3
import json, os, sys
STATE = os.environ["BRIGADE_E08_STATE"]
raw = sys.stdin.read()
try: hi = json.loads(raw) if raw.strip() else {}
except Exception: hi = {}
ti = hi.get("tool_input") or {}
with open(os.path.join(STATE, "attempts.ndjson"), "a") as f:
    f.write(json.dumps({"tool": hi.get("tool_name"), "command": ti.get("command")}) + "\n")
