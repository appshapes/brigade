#!/usr/bin/env python3
"""E0-8 PostToolUse recorder. A tool call that got past the permission gate and
ran leaves a row here; one that was prompted or denied never does."""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _e08 import append, sha12  # noqa: E402


def main():
    try:
        raw = sys.stdin.read()
    except Exception:
        raw = ""
    try:
        hi = json.loads(raw) if raw.strip() else {}
    except Exception:
        hi = {"_parse_error": True}
    ti = hi.get("tool_input") or {}
    cmd = ti.get("command") if isinstance(ti.get("command"), str) else None
    append("posttool.ndjson", {
        "event": "posttooluse",
        "tool": hi.get("tool_name"),
        "claude_pid": os.environ.get("CLAUDE_PID", ""),
        "cmd_len": len(cmd) if cmd is not None else None,
        "cmd_sha12": sha12(cmd) if cmd else "",
        "cmd_head": cmd[:200] if cmd else None,
    })
    return 0


if __name__ == "__main__":
    sys.exit(main())
