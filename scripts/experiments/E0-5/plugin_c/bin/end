#!/usr/bin/env python3
"""E0-5 checks (c)/(f) SessionEnd hook -- a passive recorder.

Records the payload `reason` (the value check (c) is asking for: does /clear
produce SessionEnd(reason=clear)?), the native session id, and the state of the
watchers directory at that instant. It does no work and takes no measurable
time, so it cannot itself perturb the budget measured in checks (d)/(h).
"""

import datetime
import json
import os
import sys
import time

STATE = os.environ["BRIGADE_STATE_DIR"]
os.makedirs(STATE, mode=0o700, exist_ok=True)
now = lambda: datetime.datetime.now().astimezone().isoformat(timespec="milliseconds")

raw = sys.stdin.read()
try:
    payload = json.loads(raw)
except ValueError:
    payload = {"_unparsed": raw[:2000]}

wd = os.path.join(STATE, "watchers")
rec = {"ts": now(), "epoch": round(time.time(), 3), "event": "SessionEnd",
       "hook_pid": os.getpid(),
       "payload_reason": payload.get("reason"),
       "payload_session_id": payload.get("session_id"),
       "payload_transcript_path": payload.get("transcript_path"),
       "payload_keys": sorted(payload.keys()),
       "env_claude_pid": os.environ.get("CLAUDE_PID", ""),
       "env_session_id": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
       "watchers_dir": sorted(os.listdir(wd)) if os.path.isdir(wd) else []}

with open(os.path.join(STATE, "sessionend.ndjson"), "a") as f:
    f.write(json.dumps(rec, sort_keys=True) + "\n")
    f.flush()
