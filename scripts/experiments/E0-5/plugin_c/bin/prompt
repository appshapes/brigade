#!/usr/bin/env python3
"""E0-5 UserPromptSubmit recorder.

The instrument that makes check (c) decidable. A message posted to the inbox
socket arrives through the same path a typed prompt does, so this hook fires
once per DELIVERED message and reports, at that instant:

  * the CURRENT native session id and transcript path (so a /clear that fires no
    SessionStart is still observable -- the id will have changed);
  * the CURRENT CLAUDE_CODE_MESSAGING_SOCKET and SHA-256 of the token, which is
    the D9 question asked again from the far side of the boundary;
  * the first 200 characters of the prompt, so a post can be matched to its
    delivery.

Firing at all is itself the delivery proof: nothing is typed at the pty.
"""

import datetime
import hashlib
import json
import os
import sys
import time

STATE = os.environ["BRIGADE_STATE_DIR"]
os.makedirs(STATE, mode=0o700, exist_ok=True)

raw = sys.stdin.read()
try:
    payload = json.loads(raw)
except ValueError:
    payload = {"_unparsed": raw[:500]}

tok = os.environ.get("CLAUDE_CODE_MESSAGING_TOKEN", "")
tsha = hashlib.sha256(tok.encode()).hexdigest() if tok else ""
rec = {"ts": datetime.datetime.now().astimezone().isoformat(timespec="milliseconds"),
       "epoch": round(time.time(), 3), "event": "UserPromptSubmit",
       "payload_session_id": payload.get("session_id"),
       "payload_transcript_path": payload.get("transcript_path"),
       "prompt_head": (payload.get("prompt") or "")[:200],
       "env_session_id": os.environ.get("CLAUDE_CODE_SESSION_ID", ""),
       "env_claude_pid": os.environ.get("CLAUDE_PID", ""),
       "env_socket": os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET", ""),
       "env_token_sha256": tsha, "env_token_sha12": tsha[:12]}

with open(os.path.join(STATE, "prompt.ndjson"), "a") as f:
    f.write(json.dumps(rec, sort_keys=True) + "\n")
    f.flush()
